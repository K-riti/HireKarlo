# HireKarlo Configuration Template
# Copy this to .env and fill in your values

# ===== DATABASE =====
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:password@localhost:5432/hirekarlo

# ===== AI/LLM SERVICES =====
# Groq (Free tier: 30 requests/minute)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL_ID=llama-3.3-70b-versatile

# HuggingFace (Free inference API)
HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_MODEL=sentence-transformers/all-minilm-l6-v2

# Azure OpenAI (Optional, for production)
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4

# ===== AUTHENTICATION =====
JWT_SECRET=your_very_secure_jwt_secret_key_min_32_chars
JWT_ISSUER=HireKarlo
JWT_AUDIENCE=HireKarlo
JWT_EXPIRY=60

# ===== ENVIRONMENT =====
ASPNETCORE_ENVIRONMENT=Development
ENVIRONMENT=development

# ===== EXTENSIONS/SDK =====
EXTENSION_API_BASE=http://localhost:8080/api
EXTENSION_API_KEY=your_extension_api_key

# ===== OPTIONAL SERVICES =====
# Redis (for caching/sessions)
REDIS_URL=redis://localhost:6379

# SendGrid (for email notifications)
SENDGRID_API_KEY=your_sendgrid_api_key

# Sentry (for error tracking)
SENTRY_DSN=your_sentry_dsn_url

# DataDog (for monitoring)
DATADOG_API_KEY=your_datadog_api_key

# ===== ADMIN =====
PGADMIN_EMAIL=admin@hirekarlo.dev
PGADMIN_PASSWORD=your_pgadmin_password
